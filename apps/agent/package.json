{
  "name": "omniware-agent-app",
  "version": "1.0.0",
  "private": true,
  "description": "Android and iOS app for the Omni-Ware agent view (agent.html), built with Capacitor.",
  "scripts": {
    "build": "node scripts/build-www.js",
    "sync": "node scripts/build-www.js && cap sync",
    "android": "node scripts/build-www.js && cap sync android && cd android && ./gradlew assembleDebug",
    "icons": "capacitor-assets generate --iconBackgroundColor '#B23A26' --splashBackgroundColor '#16203C'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capgo/capacitor-speech-recognition": "8.3.2",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
