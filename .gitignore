secretFile.env
node_modules/
# Contents, not the directory: git does not descend into an excluded
# directory, so `.claude/` would make the negation below unreachable.
.claude/*
# Project skills are shared work -- the house design system has to reach
# anyone who touches a screen, and a skill that is not committed reaches
# nobody.
!.claude/skills/
supabase/.temp/
backups/

# Design-canvas intermediates: the seeded page and the fragments the
# build script composes. The artboards, canvas.json and build inputs are
# tracked; the assembled output is not, because it is ~2 MiB of editor
# per canvas and is rebuilt by build.sh from what is.
.design/*/[a-z]*-console.html
.design/*/whats-coming-runway.html
.design/*/staff-dispatch-board.html
.design/*/assets-loans-register.html
.design/*/omni-ware-whatsapp.html
.design/*/customers-register.html
.design/*/price-list-directions.html
.design/*/_body_*.html
.design/*/_svg_*.html
.design/*/_cross_card.html
__pycache__/
*.pyc
.design/*/suppliers-buying-book.html
.design/*/put-it-right.html
.design/*/add-product-popup.html
.design/*/*.frag
.design/*/whatsapp-quote-as-a-picture.html
.design/*/inventory-movements-lens.html
.design/*/invoices-one-screen.html
.design/*/omni-ware-client-portal.html
.design/*/charges-on-the-quote.html

# Generated from supabase/migrations by tools/build-bootstrap-sql.js.
# A printout of the migrations, never a second source of them.
staging-bootstrap.sql

# Design canvases under .design/work/ are SEEDED: a ~2.5 MB copy of the
# canvas editor with the artboards pasted into it, rebuilt from the
# .dc.html sources beside it on every change. The sources and the
# canvas.json layout are the record; the seeded page is build output.
.design/work/**/*.html
!.design/work/**/*.dc.html
