secretFile.env
node_modules/
# Contents, not the directory: git does not descend into an excluded
# directory, so `.claude/` would make the negation below unreachable.
.claude/*
# Project skills are shared work -- the house design system has to reach
# anyone who touches a screen, and a skill that is not committed reaches
# nobody.
!.claude/skills/
supabase/.temp/
backups/
