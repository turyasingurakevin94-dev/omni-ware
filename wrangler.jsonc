// The Cloudflare preview of the app: the same static files Vercel
// serves, uploaded as Worker assets. Only the pages and what they load
// go up -- .assetsignore keeps out node_modules (one binary there is
// 128 MiB, past the 25 MiB cap) and everything that is source, not site.
// The api/ functions are Vercel's and do not run here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omni-ware-preview",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "."
  }
}
