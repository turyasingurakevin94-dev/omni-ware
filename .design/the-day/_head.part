<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Archivo+Black&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
  <style>
    body{margin:0;font-family:'Inter',system-ui,sans-serif;font-size:13px;color:#14171B;
      background:#E9EBED;-webkit-font-smoothing:antialiased;}
    a{color:#B23A26;} a:hover{color:#8E2C1C;}
    .mono{font-family:'IBM Plex Mono',ui-monospace,Menlo,monospace;font-variant-numeric:tabular-nums;letter-spacing:-.02em;}
    .ico{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none;}
    .ico18{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none;}
    .hair{border-bottom:1px solid #E3E7EA;}
    .hair:last-child{border-bottom:0;}
  </style>
</helmet>
